# Google Gemini API Key
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

SITE_PASSWORD=your_password

GCP_PROJECT_ID=
GCP_CLIENT_EMAIL=
GCP_PRIVATE_KEY=
GCS_BUCKET_NAME=
# Knowledge Base Configuration
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id
GOOGLE_SHEET_ID=1jHdVn72KcuHt1ZSK4gvm8zLnRM--nBuZfuXuKqiL2fg
GOOGLE_SHEET_TAB_NAME=Chats

# Zoho Desk KB (Honest to Goodness agent) — OAuth 2.0
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Optional for npm run zoho:desk-kb-probe only (expires ~1h); app uses refresh flow only
# ZOHO_ACCESS_TOKEN=
ZOHO_ORG_ID=
ZOHO_DATACENTER=com.au
# When OAuth response has api_domain https://www.zohoapis.com, use US accounts for refresh:
# ZOHO_ACCOUNTS_HOST=accounts.zoho.com
# When Desk REST base is global (not *.com.au), set:
# ZOHO_DESK_HOST=desk.zoho.com
# Web-based OAuth client only — must match Callback URL in Zoho API Console exactly
# ZOHO_REDIRECT_URI=https://your-app.example/oauth/zoho/callback
# Public portal ID for KB article search (no auth required)
ZOHO_PORTAL_ID=
# ZOHO_PORTAL_ID_2=

# Optional: npm run zoho:desk-kb-probe — narrow Desk API sampling
# ZOHO_PROBE_DEPARTMENT_ID=
# ZOHO_PROBE_CATEGORY_ID=
# IRI Systems Support AI KB defaults (department + categoryId from Zoho One KB URL); override if ids change
# ZOHO_PROBE_IRI_DEPT_ID=493989000054808139
# ZOHO_PROBE_IRI_CATEGORY_ID=493989000054766237
# ZOHO_PROBE_MAX_DEPARTMENTS=30
# ZOHO_PROBE_MAX_CATEGORIES=15
# ZOHO_PROBE_ARTICLES_PER_CAT=5
# ZOHO_PROBE_REFRESH_ONLY=1
# ZOHO_PROBE_VERBOSE_OAUTH=0  — set to 0 to shorten output on OAuth failure (default: full diagnostics)

# Local per-message trace files in .local/chat-traces/ (on by default in npm run dev)
# ENABLE_CHAT_TRACE_LOGS=true
# ENABLE_CHAT_TRACE_LOGS=false

LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT="Template Text Agent"

# ── Phase 1: order tracking (dotWMS -> Syspro -> MachShip) ───────────────────
# dotWMS — BigCommerce order + email -> Syspro freight reference (and email gate).
# Re-uses the existing dotWMS key (Welly confirmed OK; needs order# + email).
# Also used by scripts/chain-test.mjs and scripts/dotwms-access-check.mjs.
DOTWMS_API_KEY=
# Optional overrides (sensible defaults in lib/config/settings.ts):
# DOTWMS_BASE_URL=https://f.dotwms.com/api/1.0/GetFileExport/
# DOTWMS_INSTANCE_CODE=H2G
# DOTWMS_EXPORT_FILE_TYPE=GenericSQL_1323
# Prefix on a 6-digit BigCommerce order number (ASSUMPTION — confirm with Welly):
# DOTWMS_ORDER_PREFIX=BC-
# Prefix on an 8-digit Syspro number (confirmed 4 Aug: dotWMS resolves 8-digit only when SO-prefixed):
# DOTWMS_SYSPRO_PREFIX=SO

# MachShip — Syspro reference -> consignments (boxes, courier, ETA, tracking).
# Existing token for now; a read-only tracking user was agreed 16 Jul, not yet issued.
MACHSHIP_TOKEN=
# MACHSHIP_BASE_URL=https://live.machship.com
# Dev only: return the bundled fixture instead of calling live MachShip, so the
# pipeline runs before a real dual-system order is available. Unset for live.
# MACHSHIP_USE_FIXTURE=true

# Freight resolver selection + confirmed policy (Iri, 28 Jul 2026).
# Switch to 'odoo' at Odoo go-live (end Oct 2026) once OdooReferenceResolver exists.
# FREIGHT_PROVIDER=dotwms
# FREIGHT_LOOKBACK_DAYS=60
# FREIGHT_REQUIRE_VERIFIED_EMAIL=true
# Master switch for LIVE order tracking in the chat gate. Leave OFF until the API
# hardening lands; while off the "can't look up your order" deflection stays live.
# ORDER_TRACKING_ENABLED=true

# ── Internal CS/WH alert emails (server-side, SIDE-EFFECTING) ────────────────
# Leave OFF until Morgan wires the n8n workflow AND loads the shared secret.
# Default transport is the no-send Log transport.
# ALERTS_ENABLED=true
# ALERTS_FROM=members@acesolutions.com.au      # swappable (Morgan's choice for now)
# ALERTS_TO=info@goodness.com.au
# ALERTS_DEDUP_TTL_MIN=60                       # same alert (order/convo) suppressed within this window
# ALERTS_MAX_PER_HOUR=50                        # global per-instance flood cap
#
# TRANSPORT SELECTION: log | webhook | smtp   (default: log)
# ✅ CHOSEN PATH = webhook. The agent POSTs the alert JSON to an n8n webhook; n8n
# validates the shared secret, then formats + sends the email. Wording lives in
# n8n (no redeploy to change subject/body).
ALERTS_TRANSPORT=webhook
# n8n webhook endpoint (workflow not built yet — Morgan builds the n8n side):
# ALERTS_WEBHOOK_URL=https://membersaces.app.n8n.cloud/webhook/htg
# Shared secret sent as the `x-alert-secret` header on EVERY call. n8n MUST reject
# requests without it — an open webhook is a spam vector into info@goodness.com.au.
# Lives here in .env ONLY — never commit it.
# ALERTS_WEBHOOK_SECRET=your_shared_secret
# Payload the agent sends: { team, customerName, orderNumber, customerEmail, reason }
#
# ⚠️ SUPERSEDED — SMTP / Workspace app-password route. Retained as a selectable
# fallback (ALERTS_TRANSPORT=smtp) only; the webhook above is the chosen path, so
# do NOT chase a Workspace mailbox app-password / SMTP relay for this feature.
# If ever used: SPF/DKIM required; `npm i nodemailer` first.
# ALERTS_SMTP_HOST=smtp.gmail.com
# ALERTS_SMTP_PORT=587
# ALERTS_SMTP_USER=members@acesolutions.com.au
# ALERTS_SMTP_PASS=your_app_password

# ── /api/chat hardening (API-Hardening-Plan.md, Tiers 1–3) ───────────────────
# Tier 1 (error hygiene, payload caps, nosniff) is always on — no env needed.
#
# frame-ancestors + Origin check allowlist. Comma-separated EXACT origins.
# ✅ CONFIRMED production storefront origins (kept commented so copying .env.example
# to a LOCAL .env doesn't block localhost — Morgan sets this in the PROD env only).
# Once set, frame-ancestors tightens OFF '*' to exactly these and the Origin check
# stops being advisory. When UNSET: frame-ancestors stays '*' (no regression).
# CHAT_ALLOWED_ORIGINS=https://goodness.com.au,https://www.goodness.com.au,https://sandbox-honest-to-goodness.mybigcommerce.com
# Origin check is on by default (advisory until the allowlist above is set):
# CHAT_REQUIRE_ORIGIN=false        # set false to disable the Origin/Referer check entirely
#
# Tier 2 — short-lived signed request token. Keep OFF until the browser round-trip
# is smoke-tested (widget GETs /api/chat-session, sends x-chat-token on /api/chat).
# CHAT_REQUIRE_TOKEN=true          # enforce the token on /api/chat (default OFF)
# CHAT_TOKEN_SECRET=               # REQUIRED for tokens; long random string; keep secret
# CHAT_TOKEN_TTL_MIN=60            # token lifetime in minutes
#
# Tier 3 — app-level rate limiting (PER-INSTANCE; no LB/Cloud Armor, confirmed 5 Aug).
# CHAT_RATE_WINDOW_MS=60000        # sliding window
# CHAT_RATE_PER_IP=20              # max requests per IP per window
# CHAT_RATE_GLOBAL=300             # global per-instance ceiling per window
#
# Payload caps (Tier 1) — reject oversized/abusive bodies before any Gemini call.
# CHAT_MAX_MESSAGE_CHARS=8000
# CHAT_MAX_HISTORY=50
# CHAT_MAX_UPLOADS=10
# CHAT_MAX_UPLOAD_BYTES=10485760

# Test-only (scripts/chain-test.mjs) — the one order Welly volunteered:
# DOTWMS_TEST_ORDER=BC-319896
# DOTWMS_TEST_EMAIL=someone@example.com

bucket names:
honest-to-goodness-agent
