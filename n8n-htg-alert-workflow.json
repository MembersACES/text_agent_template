{
  "name": "HTG AI Alert → Gmail",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "htg",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-htg",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [ -320, 0 ],
      "webhookId": "htg"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict" },
          "combinator": "and",
          "conditions": [
            {
              "id": "secret-check",
              "leftValue": "={{ $json.headers['x-alert-secret'] }}",
              "rightValue": "PASTE_SECRET_IN_N8N_UI_DO_NOT_COMMIT",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        },
        "options": {}
      },
      "id": "if-secret",
      "name": "Secret valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [ -80, 0 ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "info@goodness.com.au",
        "subject": "=H2G AI ALERT_{{ $('Webhook').item.json.body.team }}_{{ $('Webhook').item.json.body.customerName }}",
        "emailType": "text",
        "message": "=A customer needs {{ $('Webhook').item.json.body.team }} follow-up.\n\nCustomer: {{ $('Webhook').item.json.body.customerName }}\nOrder: {{ $('Webhook').item.json.body.orderNumber }}\nEmail: {{ $('Webhook').item.json.body.customerEmail }}\nReason: {{ $('Webhook').item.json.body.reason }}\n\n— Sent automatically by the H2G chat agent.",
        "options": {}
      },
      "id": "gmail-send",
      "name": "Send Gmail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [ 180, -100 ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"ok\": true }",
        "options": { "responseCode": 200 }
      },
      "id": "respond-ok",
      "name": "200 OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [ 420, -100 ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"ok\": false, \"error\": \"unauthorized\" }",
        "options": { "responseCode": 401 }
      },
      "id": "respond-401",
      "name": "401 Unauthorized",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [ 180, 120 ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [ [ { "node": "Secret valid?", "type": "main", "index": 0 } ] ]
    },
    "Secret valid?": {
      "main": [
        [ { "node": "Send Gmail", "type": "main", "index": 0 } ],
        [ { "node": "401 Unauthorized", "type": "main", "index": 0 } ]
      ]
    },
    "Send Gmail": {
      "main": [ [ { "node": "200 OK", "type": "main", "index": 0 } ] ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "active": false
}
